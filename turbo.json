{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "build:ui",
        "build:cli"
      ],
      "description": "Build the UI and the CLI for the current machine"
    },
    "build:all": {
      "dependsOn": [
        "build:cli:all"
      ],
      "description": "Build the UI, then ALL CLI targets"
    },
    "build:cli": {
      "cache": false,
      "dependsOn": [
        "build:ui",
        "gen:fake-fs",
        "gen:constants",
        "gen:lima-types"
      ],
      "description": "nodec bundle for the host platform; build:ui then gen:fake-fs re-inline dist/ into content.gen.ts before bundling. Left uncached because its output name is host-dependent, unlike the pinned build:cli:* targets"
    },
    "build:cli:all": {
      "dependsOn": [
        "build:cli:linux:x64",
        "build:cli:linux:x64-musl",
        "build:cli:linux:arm64",
        "build:cli:linux:arm64-musl",
        "build:cli:mac:arm64",
        "build:cli:win:x64"
      ],
      "description": "Every nodec target, after the UI is built and inlined into the fake fs; nodec emits <name>-<target>[.exe] per target so all six run concurrently without colliding"
    },
    "build:cli:linux:arm64": {
      "dependsOn": [
        "build:ui",
        "gen:fake-fs",
        "gen:constants",
        "gen:lima-types"
      ],
      "outputs": [
        "dist/tasty-lima-linux-arm64"
      ]
    },
    "build:cli:linux:arm64-musl": {
      "dependsOn": [
        "build:ui",
        "gen:fake-fs",
        "gen:constants",
        "gen:lima-types"
      ],
      "outputs": [
        "dist/tasty-lima-linux-arm64-musl"
      ]
    },
    "build:cli:linux:x64": {
      "dependsOn": [
        "build:ui",
        "gen:fake-fs",
        "gen:constants",
        "gen:lima-types"
      ],
      "outputs": [
        "dist/tasty-lima-linux-x64"
      ]
    },
    "build:cli:linux:x64-musl": {
      "dependsOn": [
        "build:ui",
        "gen:fake-fs",
        "gen:constants",
        "gen:lima-types"
      ],
      "outputs": [
        "dist/tasty-lima-linux-x64-musl"
      ]
    },
    "build:cli:mac:arm64": {
      "dependsOn": [
        "build:ui",
        "gen:fake-fs",
        "gen:constants",
        "gen:lima-types"
      ],
      "outputs": [
        "dist/tasty-lima-macos-arm64"
      ]
    },
    "build:cli:win:x64": {
      "dependsOn": [
        "build:ui",
        "gen:fake-fs",
        "gen:constants",
        "gen:lima-types"
      ],
      "outputs": [
        "dist/tasty-lima-win-x64.exe"
      ]
    },
    "build:ui": {
      "description": "vite build -> dist/",
      "inputs": [
        "index.html",
        "src/**",
        "vite.config.ts",
        "tsconfig.json",
        "components.json"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "dev": {
      "description": "Boot the UI dev server and the CLI helper together",
      "with": [
        "dev:ui",
        "dev:cli"
      ]
    },
    "dev:cli": {
      "cache": false,
      "dependsOn": [
        "gen:constants",
        "gen:lima-types"
      ],
      "description": "tsx watch of the CLI entrypoint (persistent)",
      "persistent": true
    },
    "dev:ui": {
      "cache": false,
      "dependsOn": [
        "gen:constants"
      ],
      "description": "Vite dev server (persistent)",
      "persistent": true
    },
    "fix:lint": {
      "cache": false,
      "description": "biome autofixer — mutates the tree, never cache this"
    },
    "gen:constants": {
      "inputs": [
        "package.json",
        "scripts/inject-app-version.ts"
      ],
      "outputs": [
        "src/shared/constants.gen.ts"
      ]
    },
    "gen:fake-fs": {
      "dependsOn": [
        "build:ui"
      ],
      "inputs": [
        "dist/**",
        "scripts/inline-ui.ts",
        "src/cli/fake-fs/fake-fs.ts"
      ],
      "outputs": [
        "src/cli/fake-fs/content.gen.ts"
      ]
    },
    "gen:lima-types": {
      "cache": false
    },
    "preview": {
      "cache": false,
      "description": "vite preview server (persistent)",
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "test:lint",
        "test:types"
      ],
      "description": "Lint AND typecheck"
    },
    "test:lint": {
      "description": "biome check ."
    },
    "test:types": {
      "description": "tsc --noEmit",
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "tsconfig.json",
        "tsconfig.node.json"
      ]
    }
  }
}

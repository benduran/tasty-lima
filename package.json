  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "download",
      "version": "12.14.0"
    }
  },
  "files": [
    "dist/tasty-lima.js"
  ],
  "homepage": "https://github.com/benduran/tasty-lima#readme",
  "keywords": [
    "lima",
    "lima-vm",
    "vm",
    "cli",
    "gui"
  ],
  "license": "MIT",
  "name": "tasty-lima",
  "packageManager": "pnpm@12.16.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benduran/tasty-lima.git"
  },
  "scripts": {
    "build:cli": "tsx ./scripts/bundle.ts",
    "build:cli:linux:arm64": "nodec --entry ./src/cli/tasty-lima.ts --name tasty-lima --nodeVersion 26.12.0 --outDir ./dist --target linux-arm64",
    "build:cli:linux:arm64-musl": "nodec --entry ./src/cli/tasty-lima.ts --name tasty-lima --nodeVersion 26.12.0 --outDir ./dist --target linux-arm64-musl",
    "build:cli:linux:x64": "nodec --entry ./src/cli/tasty-lima.ts --name tasty-lima --nodeVersion 26.12.0 --outDir ./dist --target linux-x64",
    "build:cli:linux:x64-musl": "nodec --entry ./src/cli/tasty-lima.ts --name tasty-lima --nodeVersion 26.12.0 --outDir ./dist --target linux-x64-musl",
    "build:cli:mac:arm64": "nodec --entry ./src/cli/tasty-lima.ts --name tasty-lima --nodeVersion 26.12.0 --outDir ./dist --target macos-arm64",
    "build:cli:win:x64": "nodec --entry ./src/cli/tasty-lima.ts --name tasty-lima --nodeVersion 26.12.0 --outDir ./dist --target win-x64",
    "build:ui": "vite build",
    "clean": "rm -rf ./dist",
    "dev:cli": "tsx ./src/cli/tasty-lima.ts --noUI --allowOrigin http://localhost:60010",
    "dev:ui": "vite",
    "fix:lint": "biome check --write .",
    "gen:constants": "tsx ./scripts/inject-app-version.ts",
    "gen:fake-fs": "tsx ./scripts/inline-ui.ts",
    "gen:lima-types": "tsx ./scripts/generate-lima-types.ts",
    "preview": "vite preview",
    "release": "tsx ./scripts/release-cli.ts",
    "sign:mac": "./macos-codesign.sh sign ./dist/tasty-lima-macos-arm64",
    "test:lint": "biome check .",
    "test:types": "tsc --noEmit"
  },
  "type": "module",
  "version": "0.3.2"
}

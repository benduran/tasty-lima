  },
  "dependencies": {},
  "description": "A quick and easy-to-use UI for creating and interacting with Lima VMs. Available as a standalone, self-contained CLI binary — no Node.js or Lima preinstalled — that boots a local web UI for managing your VMs.",
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@better-builds/lets-version": "1.6.5",
    "@better-builds/nodec": "2.1.1",
    "@biomejs/biome": "2.6.4",
    "@cprussin/tsconfig": "5.0.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource/vt323": "5.3.0",
    "@hono/node-server": "2.1.5",
    "@shadcn/react": "0.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.105.0",
    "@types/command-exists": "1.2.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@types/yargs": "17.0.35",
    "@vitejs/plugin-react": "6.1.2",
    "change-case": "^5.4.4",
    "check-disk-space": "4.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "command-exists": "1.2.9",
    "copy-to-clipboard": "4.0.2",
    "date-fns": "4.4.0",
    "esbuild": "0.28.2",
    "execa": "10.2.1",
    "glob": "14.0.4",
    "hono": "4.13.14",
    "http-status-codes": "2.3.0",
    "lucide-react": "1.66.0",
    "npm-check-updates": "23.1.1",
    "open": "11.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "4.23.0",
    "sockette": "2.0.6",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "totally-tubular": "0.6.1",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "tw-animate-css": "1.4.0",
